    "@remotion/renderer": "4.0.544",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "type": "module"
